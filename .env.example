# Leave unset or empty to use static hints and deterministic code diagnostics.
# The only initially supported external coaching provider is: codex
# `just check` still uses the locally authenticated Codex CLI for its required analysis verdict.
COACH_PROVIDER=

# off | checkpoints | all
WORKSHOP_TIMER_MODE=checkpoints

# Optional positive integer override. Empty uses each lesson's recommended target.
WORKSHOP_TIMER_MINUTES=
