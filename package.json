{
  "name": "leetcode-interview-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A progressive TypeScript workshop for algorithmic interview reasoning.",
  "scripts": {
    "workshop": "tsx src/cli/index.ts",
    "practice": "tsx src/practice/index.ts",
    "bootstrap:learners": "tsx scripts/bootstrap-learners.ts",
    "test": "vitest run tests",
    "test:foundation": "vitest run tests",
    "test:lesson": "vitest run src/verification/lesson-verifier.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:references": "tsx scripts/validate-references.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
